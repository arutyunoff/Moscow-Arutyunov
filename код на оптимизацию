6. Использование обученной модели онлайн

function online_control_loop():
    # загрузить заранее обученную модель
    regressor = load_model("cycle_params_model.bin")

    while True:
        # 1. Измерить текущие потоки на подъездах за последние T минут
        demand_now = measure_current_demand()  # {"A":..., "B":..., ...}
        x_now      = demand_to_vector(demand_now)

        # 2. Предсказать параметры цикла
        y_pred = regressor.predict(x_now)      # [C_pred, g1_pred, ..., gN_pred]
        params_pred = vector_to_params(y_pred)

        # 3. Дополнительные проверки/ограничения (минимальные зелёные, макс. цикл)
        params_safe = project_params_to_feasible_region(params_pred)

        # 4. Применить эти параметры к светофору в реальном времени
        apply_params_to_signal_controller(params_safe)

        # 5. Подождать некоторое время до следующего пересчёта (например, 5–15 мин)
        sleep(update_interval)


