2. Функция оценки цикла через симулятор

function evaluate_cycle(demand, params):
    """
    demand: словарь/вектор интенсивностей по подъездам, например:
        demand = {
            "A": q_A,  # авто/час
            "B": q_B,
            "C": q_C,
            "D": q_D,
        }

    params: {"C": C, "g": [g_1,...,g_N]}
    return: scalar_cost (чем меньше, тем лучше)
    """

    # 1. Сгенерировать/обновить файл конфигурации светофора в симуляторе
    #    (например, переписать tls-план в SUMO на основе C и g)
    tls_program = build_tls_program_from_params(params)
    write_tls_to_simulator_config(tls_program)

    # 2. Запустить симуляцию на заданный горизонт T_sim (например 3600 с)
    sim = start_simulator(demand, tls_program)
    while sim.time < T_sim:
        sim.step()

    # 3. Собрать метрики за весь период
    avg_delay    = sim.get_average_delay()
    avg_stops    = sim.get_average_number_of_stops()
    avg_queue    = sim.get_average_queue_length()

    # 4. Посчитать целевую функцию
    #    Например, взвешенная сумма: задержка + очереди
    alpha = 1.0
    beta  = 0.5
    gamma = 0.2
    cost = alpha * avg_delay + beta * avg_queue + gamma * avg_stops

    return cost


