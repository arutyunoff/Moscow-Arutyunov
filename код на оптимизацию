4. Генерация датасета «потоки → оптимальные параметры цикла»

function generate_dataset(num_scenarios):

    dataset_inputs  = []  # X: спрос
    dataset_outputs = []  # y: оптимальные параметры

    for s in range(num_scenarios):

        # 1. Сгенерировать сценарий потоков (demand)
        demand = sample_random_demand()  
        # напр. q_A,q_B,q_C,q_D из разумных диапазонов

        # 2. Найти оптимальные параметры цикла под этот demand
        best_params, best_cost = optimize_cycle_for_scenario(demand)

        # 3. Записать в датасет
        # вход: вектор интенсивностей (можно в одном порядке, напр. [q_A, q_B, q_C, q_D])
        x = demand_to_vector(demand)  # [q_A, q_B, q_C, q_D]

        # выход: можно напрямую параметры [C, g_1, ..., g_N]
        y = params_to_vector(best_params)   # [C, g_1, g_2, ..., g_N]

        dataset_inputs.append(x)
        dataset_outputs.append(y)

    return dataset_inputs, dataset_outputs


