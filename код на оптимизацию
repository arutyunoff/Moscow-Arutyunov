5. Обучение ML-модели по полученному датасету

function train_cycle_regressor(X, Y):
    """
    X: список/матрица размером [num_samples, dim_demand]
    Y: список/матрица размером [num_samples, dim_params]
    """
    model = init_regression_model()  
    # например, MLP, XGBoost, RandomForestRegressor и т.п.

    model.fit(X, Y)
    return model

