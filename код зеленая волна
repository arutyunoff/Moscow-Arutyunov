3.1. Среда (env/green_wave_env.py)

import gym
import numpy as np
import traci  # интерфейс к SUMO
from gym import spaces
import os
import sys

class GreenWaveEnv(gym.Env):
    def __init__(self, sumo_cfg_path, tls_ids, step_length=1.0,
                 min_phase_green=5, max_phase_green=60):
        super(GreenWaveEnv, self).__init__()

        self.sumo_cfg_path = sumo_cfg_path
        self.tls_ids = tls_ids            # список id светофоров на магистрали
        self.step_length = step_length

        # --- ACTION SPACE ---
        # Например: для каждого светофора можно "подкрутить" длительность зелёного
        # Действие: delta_t для каждого светофора в диапазоне [-5, +5] секунд
        self.action_space = spaces.Box(
            low=-5.0, high=5.0, shape=(len(tls_ids),), dtype=np.float32
        )

        # --- OBSERVATION SPACE ---
        # Пример: для каждого подъезда – длина очереди и средняя скорость
        # Допустим у нас M подъездов всего
        self.num_approaches = 8  # пример, зависит от сети
        # Вектор: [queue_length_1,..,queue_length_M, speed_1,..,speed_M]
        self.observation_space = spaces.Box(
            low=0.0,
            high=1000.0,
            shape=(self.num_approaches * 2,),
            dtype=np.float32
        )

        self.sumo_running = False

    # ------ ВСПОМОГАТЕЛЬНЫЕ МЕТОДЫ ------

    def _start_sumo(self):
        if self.sumo_running:
            return
        sumoBinary = "sumo"  # или sumo-gui
        traci.start([sumoBinary, "-c", self.sumo_cfg_path,
                     "--step-length", str(self.step_length)])
        self.sumo_running = True

    def _stop_sumo(self):
        if self.sumo_running:
            traci.close()
            self.sumo_running = False

    def _get_state(self):
        """
        Собираем наблюдение: очереди и скорости по выбранным lane/edges.
        Здесь ты сам определяешь, какие детекторы/полосы смотришь.
        """
        queues = []
        speeds = []

        # пример: по всем полосам сети
        for lane_id in traci.lane.getIDList():
            q = traci.lane.getLastStepHaltingNumber(lane_id)  # машин со скоростью ~0
            v = traci.lane.getLastStepMeanSpeed(lane_id)      # средняя скорость
            queues.append(q)
            speeds.append(max(v, 0.0))

        # дальше можно отобрать только нужные подъезды, сократить размерность и т.п.
        # для простоты, обрежем/заполним до num_approaches
        queues = queues[:self.num_approaches]
        speeds = speeds[:self.num_approaches]

        # паддинг, если полос меньше
        while len(queues) < self.num_approaches:
            queues.append(0.0)
            speeds.append(0.0)

        obs = np.array(queues + speeds, dtype=np.float32)
        return obs

    def _apply_action(self, action):
        """
        Интерпретируем действие агента: корректируем durations фаз для tls_ids.
        Упрощённый вариант: увеличиваем/уменьшаем длительность зелёной фазы
        главного направления.
        """
        # Здесь можно работать через traci.trafficlight.getCompleteRedYellowGreenDefinition
        # и менять длительность фаз для главного направления.
        for tls_idx, tls_id in enumerate(self.tls_ids):
            delta = float(action[tls_idx])

            # пример: храним текущее целевое значение в каком-то словаре
            # self.green_times[tls_id] = np.clip(self.green_times[tls_id] + delta,
            #                                    min_phase_green, max_phase_green)
            # дальше — обновляем программу светофора.
            pass  # TODO: реализация под твою структуру

    def _compute_reward(self):
        """
        Одна из простых наград:
        - минус суммарная задержка (количество стоящих машин)
        - минус количество смен фаз (если хочешь штраф за дёрганность)
        """
        total_waiting = 0.0
        for lane_id in traci.lane.getIDList():
            # Сколько машин ждёт на полосе
            q = traci.lane.getLastStepHaltingNumber(lane_id)
            total_waiting += q

        # reward = - total_waiting
        return -total_waiting

    # ------ GYM API ------

    def reset(self, seed=None, options=None):
        super().reset(seed=seed)
        self._stop_sumo()
        self._start_sumo()

        # можно случайно "прогреть" симуляцию несколько шагов
        for _ in range(10):
            traci.simulationStep()

        obs = self._get_state()
        return obs, {}

    def step(self, action):
        # применяем действие (корректируем зелёные волны)
        self._apply_action(action)

        # Делаем несколько симуляционных шагов, чтобы увидеть эффект
        sim_steps_per_action = 5
        for _ in range(sim_steps_per_action):
            traci.simulationStep()

        obs = self._get_state()
        reward = self._compute_reward()

        # условие окончания эпизода (например, 1 "час" моделирования)
        done = traci.simulation.getTime() >= 3600  # 3600 секунд

        info = {}
        if done:
            # можно посчитать итоговые метрики и положить в info
            pass

        return obs, reward, done, False, info

    def close(self):
        self._stop_sumo()


