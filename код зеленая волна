3.3. Оценка политики (evaluate/eval_policies.py)

import numpy as np
from stable_baselines3 import PPO
from env.green_wave_env import GreenWaveEnv
import os

def run_episode(env, model, render=False):
    obs, _ = env.reset()
    done = False
    total_reward = 0
    while not done:
        action, _ = model.predict(obs, deterministic=True)
        obs, reward, done, truncated, info = env.step(action)
        total_reward += reward
    return total_reward

if __name__ == "__main__":
    sumo_cfg = os.path.join("sumo_net", "config.sumocfg")
    tls_ids = ["TL1", "TL2", "TL3"]

    env = GreenWaveEnv(sumo_cfg, tls_ids=tls_ids)

    model = PPO.load("ppo_green_wave", env=env)

    rewards = []
    for _ in range(10):
        R = run_episode(env, model)
        rewards.append(R)

    print("Средняя награда:", np.mean(rewards))
    env.close()


