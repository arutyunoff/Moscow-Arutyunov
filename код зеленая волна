3.2. Тренировка агента (train/train_ppo.py)

import os
import gym
from stable_baselines3 import PPO
from stable_baselines3.common.env_checker import check_env

from env.green_wave_env import GreenWaveEnv

def make_env():
    sumo_cfg = os.path.join("sumo_net", "config.sumocfg")
    tls_ids = ["TL1", "TL2", "TL3"]  # id светофоров из сети SUMO
    env = GreenWaveEnv(sumo_cfg, tls_ids=tls_ids)
    return env

if __name__ == "__main__":
    env = make_env()

    # Проверка на совместимость с Gym
    check_env(env, warn=True)

    model = PPO(
        "MlpPolicy",
        env,
        verbose=1,
        tensorboard_log="./tb_logs/"
    )

    model.learn(total_timesteps=200000)

    model.save("ppo_green_wave")

    env.close()


